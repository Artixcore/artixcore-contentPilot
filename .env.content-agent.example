# Content Agent Team connector settings
# Copy these values into your deployment secret manager or .env file.
# Never commit real tokens or chat IDs.

# Apify Instagram intelligence
APIFY_API_TOKEN=
APIFY_ALLOWED_ACTOR_IDS=apify/instagram-scraper

# Optional Telegram reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_IDS=

# Set per scheduled job. Use one explicit workspace per job.
CONTENTPILOT_WORKSPACE_ID=
