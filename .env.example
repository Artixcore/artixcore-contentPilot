# Application
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Dhaka
BUSINESS_LOCALE=en-BD
BUSINESS_LANGUAGE=English

# Production safety gates
# Allowed: cloudflare_access, vpn, reverse_proxy, private_network
ACCESS_CONTROL_MODE=
HTTPS_TERMINATION_ENABLED=false
TRUST_PROXY_HEADERS=false

# Authentication and account bootstrap
# Remove bootstrap password values after the first owner has been created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=ContentPilot Owner
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ORGANIZATION_NAME=Artixcore
BOOTSTRAP_ORGANIZATION_SLUG=artixcore
BOOTSTRAP_WORKSPACE_NAME=Artixcore
BOOTSTRAP_WORKSPACE_SLUG=artixcore
AUTH_SESSION_HOURS=8
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
TOTP_ISSUER=Artixcore ContentPilot

# Authenticated encryption
# Comma-separated Fernet keys. First key is active; retained keys decrypt older data.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTENTPILOT_ENCRYPTION_KEYS=

# Workspace API keys
# Use a separate random value with at least 32 characters. Never reuse an encryption key.
WORKSPACE_API_KEY_PEPPER=

# Database
# SQLite is development-only.
# Production example:
# postgresql+psycopg://user:password@db.example.com:5432/contentpilot?sslmode=verify-full
DATABASE_URL=sqlite:///data/contentpilot.db
DATABASE_TIMEOUT_SECONDS=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Background worker
WORKER_ID=
WORKER_POLL_SECONDS=2
WORKER_IDLE_SECONDS=5

# Timeouts and workload limits
DEFAULT_API_TIMEOUT_SECONDS=30
LONG_TASK_TIMEOUT_SECONDS=120
MAX_CONCURRENT_AI_REQUESTS=3
MAX_CONCURRENT_PUBLISH_REQUESTS=2
MAX_CONCURRENT_EXPORTS=2

# Rate limits
AI_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=30
PUBLISH_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=5
TELEGRAM_RATE_LIMIT_PER_MINUTE=30

# Circuit breakers
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# Cache
CACHE_PROVIDER_STATUS_TTL=60
CACHE_CONNECTOR_STATUS_TTL=60
CACHE_DASHBOARD_STATS_TTL=30
CACHE_SETTINGS_TTL=30

ENABLE_REAL_API_LOAD_TEST=false

# Operational alerts
ALERTS_ENABLED=false
ALERT_COOLDOWN_SECONDS=300
# Optional comma-separated override. Defaults to critical operational error codes.
ALERT_ERROR_CODES=
# Separate alert destinations are recommended. Falls back to TELEGRAM_ADMIN_IDS.
TELEGRAM_ALERT_CHAT_IDS=

# Telegram Controller
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8501/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202506

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_REDIRECT_URI=http://localhost:8501/x/callback

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8501/meta/callback
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_IG_USER_ID=

# Website / Artixcore CMS
WEBSITE_API_BASE_URL=
WEBSITE_API_TOKEN=
WEBSITE_POST_ENDPOINT=/api/posts
