# Copy required values into the deployment secret manager or private .env file.
# Never commit real values.

# Required production foundation
APP_ENV=production
APP_DEBUG=false
ACCESS_CONTROL_MODE=cloudflare_access
HTTPS_TERMINATION_ENABLED=true
TRUST_PROXY_HEADERS=true
DATABASE_URL=postgresql+psycopg://user:password@database.example.com:5432/contentpilot?sslmode=verify-full
CONTENTPILOT_ENCRYPTION_KEYS=
WORKSPACE_API_KEY_PEPPER=

# First owner and default tenant. Remove plaintext bootstrap password after first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=ContentPilot Owner
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ORGANIZATION_NAME=Artixcore
BOOTSTRAP_ORGANIZATION_SLUG=artixcore
BOOTSTRAP_WORKSPACE_NAME=Artixcore
BOOTSTRAP_WORKSPACE_SLUG=artixcore
BUSINESS_TIMEZONE=Asia/Dhaka
BUSINESS_LOCALE=en-BD
BUSINESS_LANGUAGE=English

# Brand Brain provider. Generated output is always stored as draft.
BRAND_BRAIN_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Outbound automation webhooks are disabled unless the target hostname is listed here.
# Store each website integration signing secret in the encrypted credential vault.
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# OAuth provider configuration. Set endpoints from current official provider documentation.
# Each endpoint must use HTTPS and its hostname must be included in the provider allowlist.
OAUTH_LINKEDIN_AUTHORIZATION_URL=
OAUTH_LINKEDIN_TOKEN_URL=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_REDIRECT_URI=https://contentpilot.example.com/
OAUTH_LINKEDIN_SCOPES=
OAUTH_LINKEDIN_ALLOWED_HOSTS=
OAUTH_LINKEDIN_TOKEN_AUTH_METHOD=client_secret_post
OAUTH_LINKEDIN_AUTHORIZE_PARAMS_JSON={}
OAUTH_LINKEDIN_TOKEN_PARAMS_JSON={}

OAUTH_X_AUTHORIZATION_URL=
OAUTH_X_TOKEN_URL=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_X_REDIRECT_URI=https://contentpilot.example.com/
OAUTH_X_SCOPES=
OAUTH_X_ALLOWED_HOSTS=
OAUTH_X_TOKEN_AUTH_METHOD=client_secret_basic
OAUTH_X_AUTHORIZE_PARAMS_JSON={}
OAUTH_X_TOKEN_PARAMS_JSON={}

OAUTH_META_AUTHORIZATION_URL=
OAUTH_META_TOKEN_URL=
OAUTH_META_CLIENT_ID=
OAUTH_META_CLIENT_SECRET=
OAUTH_META_REDIRECT_URI=https://contentpilot.example.com/
OAUTH_META_SCOPES=
OAUTH_META_ALLOWED_HOSTS=
OAUTH_META_TOKEN_AUTH_METHOD=client_secret_post
OAUTH_META_AUTHORIZE_PARAMS_JSON={}
OAUTH_META_TOKEN_PARAMS_JSON={}

# Worker and database limits
DATABASE_TIMEOUT_SECONDS=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
WORKER_ID=contentpilot-worker-1
WORKER_POLL_SECONDS=2
WORKER_IDLE_SECONDS=5

# Operational alerts
ALERTS_ENABLED=true
ALERT_COOLDOWN_SECONDS=300
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_IDS=

# Request and workload controls
DEFAULT_API_TIMEOUT_SECONDS=30
LONG_TASK_TIMEOUT_SECONDS=120
MAX_CONCURRENT_AI_REQUESTS=3
MAX_CONCURRENT_PUBLISH_REQUESTS=2
MAX_CONCURRENT_EXPORTS=2
AI_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=30
PUBLISH_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
